         "vendor/pocketmine/bedrock-protocol/src/ResourcePackClientResponsePacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/ResourcePacksInfoPacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/ServerboundDiagnosticsPacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/SetScorePacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/SetScoreboardIdentityPacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/StartGamePacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/SubChunkPacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/TransferPacket.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/serializer/CommonTypes.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/IntGameRule.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
