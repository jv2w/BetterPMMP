         "vendor/pocketmine/bedrock-protocol/src/types/recipe/MolangItemDescriptor.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/recipe/RecipeUnlockingRequirement.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/recipe/StringIdMetaItemDescriptor.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/recipe/TagItemDescriptor.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/recipe/ShapedRecipe.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/skin/PersonaPieceTintColor.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/skin/PersonaSkinPiece.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/bedrock-protocol/src/types/skin/SkinData.php": "build/betterpmmp-vendor-patches/bedrock-protocol-1.26.40.patch",
         "vendor/pocketmine/raklib/src/server/Server.php": "build/betterpmmp-vendor-patches/raklib-tick-slice.patch"
